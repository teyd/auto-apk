# Signing secrets for the publish job. Names, types and where each lives in
# Infisical; no values. Loaded only by:  varlock run -- bun src/main.ts publish
#
# In CI the publish job (environment `release`) logs in with GitHub's OIDC token
# as a machine identity that can read /signing and nothing else, and only from
# that environment. INFISICAL_PROJECT_ID and INFISICAL_IDENTITY_ID are not
# secrets; they come from repository variables. Locally, put your own identity's
# values in .env.local (git-ignored).
#
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=$INFISICAL_PROJECT_ID,
#   environment=prod,
#   identityId=$INFISICAL_IDENTITY_ID,
#   secretPath=/signing
# )
# @plugin(@varlock/effect-plugin)
# @generateEffectConfig(path=./src/env.generated.ts, effectVersion=4)
# @defaultRequired=true @defaultSensitive=true
# ---

# @sensitive=false @type=string
INFISICAL_PROJECT_ID=

# @sensitive=false @type=string
INFISICAL_IDENTITY_ID=

# The PKCS12 keystore exported from Morphe Manager, base64-encoded.
KEYSTORE_BASE64=infisical()

KEYSTORE_PASSWORD=infisical()

# @sensitive=false
KEY_ALIAS=infisical()

KEY_PASSWORD=infisical()
