{
  "name": "auto-apk",
  "version": "0.0.0",
  "private": true,
  "description": "Scheduled Morphe patch builds for the Android apps in auto-apk.json, published as GitHub releases for Obtainium. Unofficial.",
  "license": "MIT",
  "bin": {
    "auto-apk": "src/main.ts"
  },
  "type": "module",
  "scripts": {
    "auto-apk": "bun src/main.ts",
    "check": "bun src/main.ts check",
    "schema": "bun src/main.ts schema",
    "typecheck": "effect-tsgo tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun test",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "env:codegen": "INFISICAL_PROJECT_ID=placeholder INFISICAL_IDENTITY_ID=placeholder varlock codegen"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.4",
    "effect": "4.1.4",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@effect/tsgo": "0.68.1",
    "@types/bun": "1.4.4",
    "@varlock/effect-plugin": "0.1.0",
    "@varlock/infisical-plugin": "2.1.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "varlock": "1.24.0"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
